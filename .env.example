# Скопируйте в .env.local и заполните. Всё необязательно: без переменных сайт работает локально,
# заявки пишутся в .data/leads.json, Telegram пропускается.

# --- Хранилище заявок: Upstash Redis (REST) ---
# На Vercel: Storage → Marketplace → Upstash Redis, переменные подставятся сами.
# Подойдут и старые имена KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Дублирование заявок в Telegram ---
# Бота создаёт @BotFather, chat id узнаёт @userinfobot (или id группы, куда добавлен бот).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Необязательно ---
# Свой путь к файлу заявок (по умолчанию .data/leads.json).
# LEADS_FILE=
# Публичный адрес сайта для og:image и canonical, если нет Vercel (на Vercel подставится автоматически).
# NEXT_PUBLIC_SITE_URL=https://kvarta.example

# Бот: чаты команды через запятую, секрет вебхука — любая длинная случайная строка
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
